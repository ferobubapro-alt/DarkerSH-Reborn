-- ==========================================
local function CreateQuickWidget(name, toggleCallback)
    if FloatingWidgets[name] then return end -- Zaten varsa oluşturma

    local Widget = Instance.new("Frame")
    Widget.Size = UDim2.new(0, 120, 0, 40)
    Widget.Position = UDim2.new(0.8, 0, 0.5, 0)
    Widget.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    Widget.ZIndex = 100
    Widget.Active = true
    Widget.Parent = ScreenGui
    Instance.new("UICorner", Widget).CornerRadius = UDim.new(0, 8)
    
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = Color3.fromRGB(138, 43, 226)
    UIStroke.Thickness = 1.5
    UIStroke.Parent = Widget

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text = name
    Btn.Font = Enum.Font.GothamBold
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 12
    Btn.ZIndex = 101
    Btn.Parent = Widget

    MakeDraggable(Widget, Btn)
    FloatingWidgets[name] = Widget

    local isLocked = false
    local isBig = false

    -- Widget Basılı Tutma Mantığı (Ayar Menüsü)
    local wIsPressed = false
    local wFired = false
    Btn.MouseButton1Down:Connect(function()
        wIsPressed = true; wFired = false
        task.delay(0.5, function()
            if wIsPressed and not wFired then
                wFired = true
                -- Basılı tutunca özellikler değişir
                isLocked = not isLocked
                isBig = not isBig
                Widget.Active = not isLocked
                Widget.Size = isBig and UDim2.new(0, 150, 0, 50) or UDim2.new(0, 120, 0, 40)
                UIStroke.Color = isLocked and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(138, 43, 226)
                Notify(name .. (isLocked and " Widget Kitlendi & Büyüdü" or " Widget Açıldı"))
            end
        end)
    end)

    Btn.MouseButton1Up:Connect(function()
        wIsPressed = false
        if not wFired then
            toggleCallback() -- Tıklanınca asıl özelliği çalıştır
        end
    end)
    Btn.MouseLeave:Connect(function() wIsPressed = false end)
end

local function RemoveQuickWidget(name)
    if FloatingWidgets[name] then
        FloatingWidgets[name]:Destroy()
        FloatingWidgets[name] = nil
        Notify(name .. " Hızlı Butonu Kaldırıldı.")
    end
end

