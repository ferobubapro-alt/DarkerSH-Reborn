                if FloatingWidgets[name] then
                    RemoveQuickWidget(name)
                else
                    CreateQuickWidget(name, FireToggle)
                    Notify(name .. " Hızlı Buton Eklendi!")
                end
            end
        end)
    end)

    ClickArea.MouseButton1Up:Connect(function()
        isPressed = false
        if not longPressFired then FireToggle() end
    end)

    ClickArea.MouseLeave:Connect(function() isPressed = false end)
end

