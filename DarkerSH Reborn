local function CreateQuickWidget(name, toggleCallback)
    if FloatingWidgets[name] then return end

    local Widget = Instance.new("Frame")
    Widget.Size = UDim2.new(0, 120, 0, 40)
    Widget.Position = UDim2.new(0.8, 0, 0.5, 0)
    Widget.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    Widget.ZIndex = 100
    Widget.Active = true
    Widget.Parent = ScreenGui
    Instance.new("UICorner", Widget).CornerRadius = UDim.new(0, 8)
    
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = Color3.fromRGB(138, 43, 226)
    UIStroke.Thickness = 1.5
    UIStroke.Parent = Widget

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text = name
    Btn.Font = Enum.Font.GothamBold
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 12
    Btn.ZIndex = 101
    Btn.Parent = Widget

    MakeDraggable(Widget, Btn)
    FloatingWidgets[name] = Widget

    local isLocked = false
    local isBig = false

    local wIsPressed = false
    local wFired = false
    Btn.MouseButton1Down:Connect(function()
        wIsPressed = true; wFired = false
        task.delay(0.5, function()
            if wIsPressed and not wFired then
                wFired = true
                isLocked = not isLocked
                isBig = not isBig
                Widget.Active = not isLocked
